# Markdown is opt-in: keep the project docs and the redistributable sample
# worlds, while leaving other working notes/content out of a normal source push.
*.md
!README.md
!README.ko.md
!NOTICE.md
!/docs/
!/docs/**/*.md
/docs/research-*.md
!/worlds/examples/
!/worlds/examples/**/*.md
!/worlds/import-samples/
!/worlds/import-samples/**/*.md
!/apps/desktop/public/fonts/FONTS.md

# Keep local collection scripts and intermediate world fragments out of releases.
/worlds/blue-archive/
/worlds/blue-archive.😭
/worlds/.parts/
/tools/blue-archive/

# Release-ready text-only world package and generated local-model files.
!/worlds/blue-archive/
!/worlds/blue-archive/**/
!/worlds/blue-archive/**/*.md
!/worlds/blue-archive/**/*.yaml
!/worlds/blue-archive/**/*.json
!/worlds/blue-archive.😭
/local-models/
*.gguf

